--!strict
-- The chain of areas: which area the game is on, its map (generated by the mod's gen/area.luau),
-- the next one generated ahead while this one is played, and the ways from one to another (the
-- exit on, a waypoint's travel, the gate to the next act; with anyone else in the game, after the
-- party's vote: votes.luau).
--
-- Each act is a fixed chain (data/acts.luau): area 1 to its lair, the area level rising with the
-- index. The areas are numbered on through the acts ("places": act 1's are 1-7, act 2's start at
-- 8), so one number names an area wherever the game goes; areas.info gives its act and its index
-- in the act. Maps take turns between two tags ("a", "b": DD_<slot>A, DD_<slot>B), so the area
-- the game goes to next is always built into the map not being played: the next area of the act
-- as soon as this one is entered (built on a worker); in a lair, the next act's first area once
-- the gate opens (gate.luau); for a waypoint's travel, the waypoint's area instead (the ahead
-- build replaced). A map change waits for a build that isn't done yet.
--
-- Which area is being played comes from the map the engine loaded (mapLoaded's name, the same
-- as nox.currentMap()), looked up in what each tag holds; so it holds when the host changes the
-- map itself. A map that isn't one of the mod's holds nothing of it: the game is sent back to
-- its area.
--
-- Every map is drawn from the play's seed and the area's place, so within a play an area keeps its
-- map (a waypoint back to it finds the same one). A play is a game's first, or an emptied game
-- starting over in act 1 (areas.home): a new seed, nothing kept from the old play's maps.
--
-- An area is entered once both its map has loaded and its spots (the generator's result) are in:
-- its stations, pentagrams and exits set to work (the pads' rings drawn under them), the vendor's
-- stock rolled at its level, its monsters (and boss) put in, its weather set (an outdoor area's;
-- none again on coming back indoors), its players set up.

local acts = require("data/acts")
local numbers = require("data/numbers")
local boss = require("boss")
local decals = require("decals")
local gate = require("gate")
local hero = require("hero")
local hud = require("hud")
local loot = require("loot")
local items = require("items")
local labels = require("labels")
local monsters = require("monsters")
local portal = require("portal")
local stash = require("stash")
local summons = require("summons")
local town = require("town")
local touch = require("touch")
local vendor = require("vendor")
local votes = require("votes")
local waypoints = require("waypoints")
local windows = require("windows")

local areas = {}

local OTHER: { [string]: string } = { a = "b", b = "a" }
local TAGS = { "a", "b" }

-- Every area of every act in order: place -> { act, index }; and each act's first place.
local places: { { act: number, index: number } } = {}
local firstOf: { [number]: number } = {}
for a, act in ipairs(acts) do
	firstOf[a] = #places + 1
	for i in act.areas do
		table.insert(places, { act = a, index = i })
	end
end

local state: any = {
	seed = 1, -- the play's seed: every area's map is drawn from it and the area's place
	play = 1, -- which play of this game it is (a new one each time an emptied game starts over)
	place = 0, -- the area being played (1 the first)
	tag = "a", -- its map's tag
	held = {}, -- tag -> the place generated into its map
	spots = {}, -- tag -> the generator's spots for the map in it
	loaded = false, -- the area's map has loaded
	entered = false, -- it's been entered (its things made)
	arriving = nil, -- how those who came by a map change arrive: "start", "waypoint" (nil: town)
	nextArea = nil, -- { place, tag }: the one generated ahead
	pending = nil, -- { place, tag, arrive }: the one the game is changing to
	leaving = false,
	tries = 0, -- a failed build's retries
	weather = nil, -- the weather's name last set for everyone (nil: none ever set)
}

-- ---- An area's facts

-- How many areas there are in all the acts (the last place).
function areas.count(): number
	return #places
end

-- The place of area `index` of act `act` (nil: no such area).
function areas.placeOf(act: number, index: number): number?
	local first = firstOf[act]
	if not first or index < 1 or index > #acts[act].areas then
		return nil
	end
	return first + index - 1
end

-- The area at `place` (clamped to the areas there are): its act and index in it, its biome,
-- level, layout, packs, weather, and what it holds (area level = the act's base level plus the
-- index less one).
function areas.info(place: number)
	local p = places[math.clamp(place, 1, #places)]
	local act = acts[p.act]
	local i = p.index
	local spec: any = act.areas[i]
	local level = act.base + i - 1
	local a = numbers.areas
	local lair = spec.lair == true
	-- (the opening's numbers at this level, when it has them: numbers.areas.opening)
	local opening: any = if lair then nil else (a.opening :: any)[level]
	local packs = if lair then a.lair.packs else math.min(a.packs.most, math.floor(a.packs.base + a.packs.perLevel * level))
	if opening then
		packs = opening.packs
	end
	return {
		place = firstOf[p.act] + i - 1,
		index = i,
		act = p.act,
		level = level,
		biome = spec.biome,
		corridor = spec.corridor,
		title = (spec.title or spec.biome) .. " " .. i,
		waypoint = spec.waypoint == true,
		waypointAt = spec.waypointAt,
		lair = lair,
		-- (a lair with an act after it: its boss's death opens the gate on)
		gate = lair and acts[p.act + 1] ~= nil,
		weather = if lair then nil else spec.weather,
		segments = if lair then a.lair.segments else math.min(a.segments.most, math.floor(a.segments.base + a.segments.perLevel * level)),
		packs = packs,
		endRadius = if lair then a.lair.endRadius else a.endRadius,
		opening = opening,
	}
end

-- The area's map seed: the play's seed and the area's place (and a retry's count), so a play's
-- areas are stable while it lasts (a waypoint's area built again is the same map) and new each
-- play: a new game, or an emptied game starting over (areas.home).
local function seedOf(place: number, retry: number): number
	return (state.seed * 7919 + place * 104729 + retry * 1299709) % 2147483647
end

-- A new play's seed: the mode's random stream mixed with the frame (when the game emptied), so
-- a host restarted with the same game seed doesn't play the same areas again either.
local function freshSeed(): number
	local r = math.floor(nox.random(1, 2147483646))
	return (r + nox.frame() * 48271) % 2147483646 + 1
end

-- The town of act `act`: { name, look } (data/acts.luau's).
function areas.townOf(act: number): any
	local a = acts[act]
	return (a and a.town) or acts.town
end

-- nox.generate's request for the area at `place` into map `tag`.
function areas.request(place: number, tag: string, ahead: boolean, retry: number?): any
	local info = areas.info(place)
	local seed = seedOf(place, retry or 0)
	return {
		map = tag,
		module = "area",
		fn = "build",
		seed = seed,
		title = "Deep Delve: " .. info.title,
		ahead = ahead,
		params = {
			biome = info.biome,
			corridor = info.corridor,
			segments = info.segments,
			endRadius = info.endRadius,
			packs = info.packs,
			ramp = if info.opening then info.opening.ramp else 0,
			town = areas.townOf(info.act).look,
			waypoint = info.waypoint,
			waypointAt = info.waypointAt,
			lair = info.lair,
			gate = info.gate,
		},
	}
end

-- The area being played: { place, index (in its act), act, tag, spots } (spots nil until they're
-- in).
function areas.current(): any
	local p = places[math.max(1, state.place)]
	return { place = state.place, index = p.index, act = p.act, tag = state.tag, spots = state.spots[state.tag] }
end

-- ---- Building and going

-- The area at `place` built ahead into map `tag` (what was there or on its way, dropped).
local function build(place: number, tag: string)
	nox.cancelGenerate(tag)
	state.nextArea = { place = place, tag = tag }
	state.held[tag] = place
	state.spots[tag] = nil
	local ok, why = nox.generate(areas.request(place, tag, true, state.tries))
	if not ok then
		nox.log("deep_delve: area " .. place .. " not started: " .. tostring(why))
	end
end

-- The area after this one in its act built ahead (none after a lair until its gate opens).
local function generateNext()
	local info = areas.info(state.place)
	if info.lair then
		state.nextArea = nil
		return
	end
	build(state.place + 1, OTHER[state.tag])
end

-- The game to the area at `place` in the other map tag (built there unless it's there or on its
-- way already), its players arriving at `arrive`; `fresh`: a new play's first map, the old play's
-- other map dropped as it loads.
local function go(place: number, arrive: string, fresh: boolean)
	local tag = OTHER[state.tag]
	local n = state.nextArea
	if not (n and n.place == place and n.tag == tag and nox.generating(tag) ~= "failed") then
		build(place, tag)
	end
	state.leaving = true
	hero.saveAll("area change")
	hero.mapChanging()
	state.pending = { place = place, tag = tag, arrive = arrive, fresh = fresh }
	nox.textToAll("Deep Delve: on to " .. areas.info(place).title .. ".")
	nox.exitTo(nox.mapName(tag) .. ".map")
end

-- The whole game to the area at `place`, its players arriving at `arrive` ("start": its start
-- chamber; "waypoint": beside its waypoint): every record written, the area built into the other
-- map tag unless it's there or on its way already, the map changed. Whether it went (else why).
function areas.travel(place: number, arrive: string): (boolean, string?)
	if state.leaving then
		return false, "on the way already"
	end
	if place < 1 or place > #places then
		return false, "no such area"
	end
	if place == state.place then
		return false, "here already"
	end
	go(place, arrive, false)
	return true, nil
end

-- A new play: a new seed (every area's map new from here on), and nothing built from the old one
-- kept but the map being played until the game leaves it (the area built ahead in the other tag
-- stopped and forgotten, its spots too).
function areas.freshPlay()
	state.seed = freshSeed()
	state.play += 1
	local other = OTHER[state.tag]
	nox.cancelGenerate(other)
	state.held[other] = nil
	state.spots[other] = nil
	state.nextArea = nil
	state.tries = 0
end

-- An empty game started over (a server's game, its last player gone): a new play (areas.freshPlay),
-- back to act 1's first area, its town, built new (the next to come starts where every character
-- can, on maps nobody has seen; even when the game was in that area already). Whether it went.
function areas.home(): boolean
	if state.leaving then
		return false
	end
	areas.freshPlay()
	go(1, "town", true)
	return true
end

-- A player stepped on the exit: the game on to the next area, arriving at its start (the party's
-- vote when anyone else is in the game: votes.luau). Whether it went or a vote started.
function areas.exitTouched(unit: number): (boolean, string?)
	local n = state.nextArea
	if state.leaving or not n then
		return false, "no way on"
	end
	if nox.generating(n.tag) == "failed" then
		nox.tell(unit, "The way on is blocked; it's being cleared. Try again in a moment.")
		state.tries += 1
		build(n.place, n.tag)
		return false, "blocked"
	end
	local h = hero.byUnit(unit)
	if not h then
		return areas.travel(n.place, "start")
	end
	return votes.ask(h, n.place, "start", "exit")
end
local exitTouched = areas.exitTouched

-- The lair's gate opened (gate.luau): the next act's first area built ahead.
function areas.gateOpened(act: number)
	local first = firstOf[act + 1]
	if not first then
		return
	end
	local n = state.nextArea
	if not (n and n.place == first and n.tag == OTHER[state.tag]) then
		build(first, OTHER[state.tag])
	end
end

-- A hero stepped into the open gate: on to the next act's first area, arriving at its start (the
-- party's vote when anyone else is in the game). Whether it went or a vote started.
function areas.gateTouched(h: any): (boolean, string?)
	local info = areas.info(state.place)
	local first = firstOf[info.act + 1]
	if state.leaving or not info.gate or not first then
		return false, "no way on"
	end
	local n = state.nextArea
	if n and n.place == first and nox.generating(n.tag) == "failed" then
		state.tries += 1
		build(first, n.tag)
	end
	return votes.ask(h, first, "start", "gate")
end

-- A unit through a way within the map: put at `at`, with the teleport's flash.
local function moveTo(unit: number, at: any)
	nox.setPosition(unit, at.x, at.y)
	nox.effect(0x89, at.x, at.y) -- (MSG_FX_TELEPORT)
end

-- The area's weather for everyone: an outdoor area's own; on coming back to an area with none,
-- none again (a game that never goes outdoors never sets any).
local function setWeather(info: any)
	local name = info.weather
	if name == state.weather or (name == nil and state.weather == nil) then
		return
	end
	local w = name and (acts.weathers :: any)[name]
	if w then
		nox.weather(nil, w)
		state.weather = name
	else
		nox.weather(nil, { kind = "none", fade = 60 })
		state.weather = nil
	end
end

-- The area's things set to work, its monsters put in, its players set up: once its map has
-- loaded and its spots are in.
local function enter()
	local spots = state.spots[state.tag]
	if state.entered or not state.loaded or not spots then
		return
	end
	state.entered, state.leaving = true, false
	local info = areas.info(state.place)
	town.place(spots.town, function(unit)
		moveTo(unit, spots.arrive)
	end, stash.touched, vendor.touched, areas.townOf(info.act).name)
	vendor.restock(info.level)
	portal.place(spots.town)
	waypoints.place(spots, info, areas)
	decals.place(spots)
	touch.adopt(spots.back.type, spots.back.x, spots.back.y, town.sendHome)
	if spots.exit then
		touch.adopt(spots.exit.type, spots.exit.x, spots.exit.y, exitTouched, 15)
	end
	setWeather(info)
	monsters.populate(spots, info)
	if info.lair then
		boss.enter(spots, info)
	end
	hero.reached(info)
	hud.area(info, hero.all())
	local at = nil
	if state.arriving == "start" then
		at = spots.arrive
	elseif state.arriving == "waypoint" then
		at = spots.wayArrive or spots.arrive
	end
	hero.setUpAll(at)
	-- (arriving beside a waypoint finds it; so does arriving at the start of an area whose
	-- waypoint stands by it: an act's first, found as the party comes through the gate)
	if spots.waypoint and (state.arriving == "waypoint" or (state.arriving == "start" and info.waypointAt == "start")) then
		waypoints.foundByAll()
	end
	state.arriving = nil
	generateNext()
	-- (after the next area's build: an open gate builds the next act's first in its place)
	gate.enter(spots, info, areas)
end

-- mapLoaded: a new map (its name, as nox.currentMap gives it). One of the mod's: the area its
-- tag holds is the game's now (arriving as the map change said, when it was the mod's own). Any
-- other: nothing of the mod's is in it, and the game goes back to its area.
function areas.mapLoaded(name: string)
	-- (the old map's things are gone with it, and every player is stripped by the change)
	monsters.reset()
	loot.reset()
	labels.reset()
	items.reset()
	touch.reset()
	decals.reset()
	portal.reset()
	waypoints.reset()
	boss.reset()
	gate.reset()
	summons.reset()
	windows.reset()
	votes.reset()
	hero.mapChanging()
	state.entered = false
	local tag = nil
	for _, t in TAGS do
		if string.upper(name) == string.upper(nox.mapName(t)) then
			tag = t
		end
	end
	local p = state.pending
	state.pending = nil
	if tag and state.held[tag] then
		state.place, state.tag = state.held[tag], tag
		state.arriving = if p and p.tag == tag then p.arrive else nil
		if p and p.fresh and p.tag == tag then
			-- (a new play's first map: the old play's, left in the other tag, holds nothing now)
			state.held[OTHER[tag]] = nil
			state.spots[OTHER[tag]] = nil
		end
		state.loaded = true
		state.leaving = false
		state.tries = 0
		-- (a frame on: the map's own things settled first)
		nox.after(1, enter)
		return
	end
	state.loaded = false
	local title = areas.info(math.max(1, state.place)).title
	nox.log("deep_delve: " .. name .. " isn't one of Deep Delve's maps; back to " .. title)
	nox.textToAll("Deep Delve plays only its own areas: back to " .. title .. ".")
	state.leaving = true
	state.pending = { place = state.place, tag = state.tag, arrive = nil }
	nox.after(30, function()
		nox.exitTo(nox.mapName(state.tag) .. ".map")
	end)
end

-- configure: the first area's request (built before the game). The first play's seed is the
-- game's (new for each game: a pool's instance, a player's own host).
function areas.configure(ctx: any)
	state.seed = if ctx.seed and ctx.seed ~= 0 then ctx.seed else 1
	state.play = 1
	state.place, state.tag = 1, "a"
	state.held.a = 1
	return areas.request(1, "a", false)
end

-- onGenerated: a map built ahead is written (its spots kept), or it failed (built again, up to
-- three more times with another seed).
function areas.generated(tag: string, ok: boolean, result: any)
	if ok then
		state.spots[tag] = result
		if tag == state.tag then
			enter()
		end
		return
	end
	nox.log("deep_delve: area map " .. tag .. " failed: " .. tostring(result))
	local n = state.nextArea
	if n and n.tag == tag and state.tries < 3 then
		state.tries += 1
		build(n.place, tag)
	end
end

-- The area at `place` built now from game seed `seed` into the trial tag ("t": DD_<slot>T, never
-- played), for "dd trial": whether it built (and its spots), else why.
function areas.trial(place: number, seed: number): (boolean, any)
	local keep = state.seed
	state.seed = seed
	local request = areas.request(place, "t", false)
	state.seed = keep
	local ok, result = nox.generate(request)
	if ok then
		return true, result
	end
	return false, tostring(result)
end

-- What "dd status" says of the area.
function areas.status()
	local info = areas.info(math.max(1, state.place))
	return {
		place = state.place,
		index = info.index,
		act = info.act,
		tag = state.tag,
		map = nox.currentMap(),
		title = info.title,
		level = info.level,
		biome = info.biome,
		lair = info.lair,
		weather = state.weather,
		entered = state.entered,
		nextState = if state.nextArea then (nox.generating(state.nextArea.tag) or "none") else "none",
		nextPlace = if state.nextArea then state.nextArea.place else nil,
		spots = state.spots[state.tag],
		seed = state.seed,
		play = state.play,
		town = areas.townOf(info.act),
	}
end

-- (votes.luau moves the game when a vote passes: it's handed this module, which requires it)
votes.attach(areas)

return areas
